# ==============================================================================
# Loan Document Processing Agent — Cloud & Local Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="Loan Document Processing Agent API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
PORT=8000

# CORS Configuration
# For local development: "*"
# For production: specify Vercel frontend URL(s) comma-separated, e.g.:
# CORS_ORIGINS="https://your-frontend.vercel.app,http://localhost:5173"
CORS_ORIGINS="*"

# Database Configuration
# Local Development (SQLite):
DATABASE_URL="sqlite:///./loan_agent.db"
# Cloud PostgreSQL (Render / Neon / Supabase / AWS RDS):
# Example: DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Note: URLs starting with postgres:// are automatically converted to postgresql://

# LLM Provider Configuration ("gemini", "groq", or "ollama")
LLM_PROVIDER="gemini"

# Google Gemini API Configuration (Recommended free tier for cloud deployment)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Groq LLM Configuration (Alternative cloud provider)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Ollama Local LLM Configuration (Local machine fallback only; not used in cloud)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Storage Configuration (Defaults to ./data within project)
DATA_DIR="./data"

# Frontend Configuration (For Vercel project environment variables)
# In Vercel Project Settings -> Environment Variables, add:
# VITE_API_URL="https://your-backend.onrender.com"
