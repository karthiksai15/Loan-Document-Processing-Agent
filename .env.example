# Application Settings
PROJECT_NAME="Loan Document Processing Agent API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# LLM Provider Configuration ("gemini" or "ollama")
LLM_PROVIDER="gemini"

# Gemini API Configuration (Free tier)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Ollama Local LLM Configuration (Local zero-cost fallback)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Groq LLM Configuration (Phase 15 LLM Service)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Database Configuration
DATABASE_URL="sqlite:///./loan_agent.db"
